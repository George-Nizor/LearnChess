{
  "name": "learnchess",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "vendor:engine": "tsx scripts/vendor-engine.ts",
    "vendor:sqlite": "tsx scripts/vendor-sqlite.ts",
    "vendor:sounds": "tsx scripts/vendor-sounds.ts",
    "vendor:piece-sets": "tsx scripts/vendor-piece-sets.ts",
    "build:puzzles": "tsx scripts/build-puzzles.ts",
    "vendor:all": "npm run vendor:engine && npm run vendor:sqlite && npm run vendor:sounds && npm run vendor:piece-sets"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.47.0-build1",
    "@tanstack/react-query": "^5.59.0",
    "chess.js": "^1.0.0",
    "chessground": "^9.1.0",
    "framer-motion": "^12.38.0",
    "idb": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.1.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "better-sqlite3": "^11.7.0",
    "csv-parse": "^5.6.0",
    "eslint": "^9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "fzstd": "^0.1.1",
    "globals": "^15.14.0",
    "happy-dom": "^15.11.0",
    "stockfish": "^16.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
